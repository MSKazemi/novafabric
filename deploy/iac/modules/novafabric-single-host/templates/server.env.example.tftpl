# Example of ${env_file} - rendered by deploy/iac/modules/novafabric-single-host.
# This example holds NO secret values. Copy it, fill the values from your secret
# store, and keep the real file root-owned and private:
#
#   sudo install -m 0600 -o root -g root /dev/null ${env_file}
#   sudoedit ${env_file}
#   sudo systemctl start novafabric
#
%{ if backend == "postgres" ~}
# backend = postgres: the service is skipped until this file exists.
%{ for env_name, ref in secret_references ~}
# ${env_name}: read from secret "${ref}"
%{ endfor ~}
NOVAFABRIC_POSTGRES_DSN=
NOVAFABRIC_METADATA_DSN=
%{ else ~}
# backend = sqlite: no secret is required. Without OIDC the server generates a
# local bearer token at ${state_dir}/home/.server-token (mode 0600).
# Optional: pin a token you generated yourself instead.
# NOVAFABRIC_SERVER_TOKEN=
%{ endif ~}
