# EXAMPLE ONLY - not installed or enabled by cloud-init.
# Rendered by deploy/iac/modules/novafabric-single-host. TLS is the operator's
# responsibility: install nginx yourself, provision a certificate and key at
# the paths below (or change them), review this file, then place it in
# /etc/nginx/conf.d/novafabric.conf.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${hostname};

    ssl_certificate     /etc/ssl/novafabric/fullchain.pem;
    ssl_certificate_key /etc/ssl/novafabric/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Capsule uploads: matches the server's default ingest.max_upload_bytes
    # (256 MiB). Change both together.
    client_max_body_size 256m;

    location / {
        proxy_pass http://${listen_host}:${port};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
