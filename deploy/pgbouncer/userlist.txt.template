; PgBouncer userlist.txt template.
;
; Each line: "username" "password-or-scram-verifier"
;
; For scram-sha-256 (recommended), generate the verifier with:
;   psql -c "SELECT rolpassword FROM pg_authid WHERE rolname='novafabric_app';" postgres
; The output looks like: SCRAM-SHA-256$<iterations>:<salt>$<storedkey>:<serverkey>
;
; IMPORTANT: Never commit this file with real credentials.
; This template shows the required format only.

"novafabric_app" "SCRAM-SHA-256$REPLACE_WITH_REAL_VERIFIER"
"novafabric_migrator" "SCRAM-SHA-256$REPLACE_WITH_REAL_VERIFIER"
"pgbouncer_admin" "SCRAM-SHA-256$REPLACE_WITH_REAL_VERIFIER"
