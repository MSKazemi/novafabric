# EXAMPLE ONLY — replace values with real certificates before applying.
# Never commit this file with real certificate data.
#
# Generate with:
#   kubectl create secret tls novaseal-mtls-cert \
#     --cert=path/to/tls.crt \
#     --key=path/to/tls.key \
#     --namespace=novafabric \
#     --dry-run=client -o yaml > secret-novaseal-mtls.yaml
#
# Then add the CA certificate:
#   kubectl patch secret novaseal-mtls-cert -n novafabric \
#     --type='json' \
#     -p='[{"op":"add","path":"/data/ca.crt","value":"'$(base64 -w0 ca.crt)'"}]'
apiVersion: v1
kind: Secret
metadata:
  name: novaseal-mtls-cert
  namespace: novafabric
  labels:
    app.kubernetes.io/name: novafabric
    app.kubernetes.io/component: novaseal
type: kubernetes.io/tls
data:
  tls.crt: <base64-encoded-certificate>
  tls.key: <base64-encoded-private-key>
  ca.crt: <base64-encoded-ca-certificate>
