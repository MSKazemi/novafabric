# {{ ansible_managed }}
# Secrets for the NovaFabric service. Mode 0600, owner root: systemd reads this file
# before dropping privileges; the service user cannot read it.
{% for key, value in novafabric_secret_env | dictsort %}
{{ key }}="{{ value | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') }}"
{% endfor %}
