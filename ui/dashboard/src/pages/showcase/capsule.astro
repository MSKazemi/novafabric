---
import Layout from '../../components/layout/Layout.astro';
import ShowcaseBadge from '../../components/layout/ShowcaseBadge.astro';
import CapsuleInspector from '../../components/capsule/CapsuleInspector';
import CodeBlock from '../../components/ui/CodeBlock.astro';
---

<Layout
  title="Run capsule inspector — NovaFabric Showcase"
  description="Inside one captured AI run: manifest, OTel trace, model calls, tool calls, environment, redaction proof. Validate against the real schema in your browser."
>
  <article class="container-content py-12">
    <header class="mb-8 max-w-3xl">
      <ShowcaseBadge variant="page" />
      <p class="mt-4 text-xs uppercase tracking-wider text-[var(--color-text-faint)]">Primitive 02 — interactive demo</p>
      <h1 class="mt-1 text-4xl font-medium tracking-tight text-balance">Run capsule inspector</h1>
      <p class="mt-3 text-[var(--color-text-muted)] max-w-2xl">
        Below is one real capsule from the demo fixture
        (<code class="text-[var(--color-text)] font-mono text-sm">RUN_A</code>) — the same schema-validated
        format <code class="text-[var(--color-text)] font-mono text-sm">nova capture</code> writes for
        every run. Click a file to open it. Hover a trace span to see its
        model or tool call.
      </p>
    </header>

    <CapsuleInspector client:visible />

    <aside class="mt-8 max-w-3xl rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-raised)] p-5 text-sm text-[var(--color-text-muted)] leading-relaxed">
      <p class="text-[var(--color-text)] font-medium mb-2">The wow moment</p>
      <p>
        Click <strong>"Validate against schema"</strong> in the header. Your
        browser compiles
        <code class="text-[var(--color-text)] font-mono text-xs bg-[var(--color-bg-sunken)] px-1.5 py-0.5 rounded">run-capsule.schema.json</code> —
        the same JSON Schema 2020-12 file committed under
        <code class="text-[var(--color-text)] font-mono text-xs bg-[var(--color-bg-sunken)] px-1.5 py-0.5 rounded">/schemas/</code>
        in the repo — and validates the fixture against it. Green check is real,
        not marketing.
      </p>
    </aside>

    <section class="mt-12 max-w-3xl">
      <h2 class="text-xl font-medium text-[var(--color-text)] tracking-tight mb-4">On your machine</h2>
      <CodeBlock code="nova capture python your_agent.py
nova inspect <run-id>
nova validate <run-id>" lang="bash" />
    </section>
  </article>
</Layout>
