{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novafabric.io/schemas/agent-execution-graph.schema.json",
  "$comment": "Accepted (ADR-0124, 2026-07-13); implemented experimental 2026-07-15. Graduated from design/spec/schemas/ \u2014 identity metadata changed only, contract unchanged. schema_version 0.1.0. Tracks design/spec/agent-execution-graph-v0.md. A read-only, content-addressed projection of ONE capsule's model/tool/span records into its execution DAG; adds no capture path.",
  "title": "AgentExecutionGraph",
  "description": "Deterministic, content-addressed execution DAG reconstructed from one Run Capsule.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capsule_id",
    "nodes",
    "edges",
    "graph_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "capsule_id": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "label",
          "started_at",
          "duration_ms"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "model_call",
              "tool_call",
              "span",
              "root"
            ]
          },
          "label": {
            "type": "string"
          },
          "started_at": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          },
          "duration_ms": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          },
          "status": {
            "enum": [
              "success",
              "error",
              "timeout",
              "denied",
              "partial"
            ]
          },
          "mutation_class": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "from",
          "to"
        ],
        "properties": {
          "type": {
            "enum": [
              "span_parent",
              "agent_invokes_tool",
              "follows"
            ]
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "graph_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reconstruction_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "node_id",
          "detail"
        ],
        "properties": {
          "kind": {
            "enum": [
              "missing_parent",
              "orphan_tool_call",
              "unlinked_span"
            ]
          },
          "node_id": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node_count": {
          "type": "integer",
          "minimum": 0
        },
        "edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0
        },
        "max_fan_out": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
