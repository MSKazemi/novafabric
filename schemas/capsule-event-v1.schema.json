{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novafabric.dev/schemas/capsule-event-v1.schema.json",
  "title": "CapsuleEvent",
  "description": "Envelope for all capsule events (cap-001, ADR-0066, schema version 1.0.0)",
  "type": "object",
  "required": ["run_id", "event_type", "tenant_id", "capsule_id", "timestamp", "schema_version"],
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Unique identifier for the run (ULID or UUID)"
    },
    "event_type": {
      "type": "string",
      "description": "Capsule event type (25 baseline ADR-0066 + 8 extended ADR-0082 + EndpointRouted ADR-0220)",
      "enum": [
        "RunStarted",
        "RunCompleted",
        "RunFailed",
        "RunAborted",
        "ModelCallStarted",
        "ModelCallCompleted",
        "ModelCallFailed",
        "ToolCallStarted",
        "ToolCallCompleted",
        "ToolCallFailed",
        "ToolPermissionGranted",
        "ToolPermissionDenied",
        "FileReadEvent",
        "FileWriteEvent",
        "NetworkCallEvent",
        "ArtifactProduced",
        "ArtifactConsumed",
        "EnvironmentLocked",
        "SecretRedacted",
        "PIIDetected",
        "PolicyEvaluated",
        "HumanApprovalRequested",
        "HumanApprovalGranted",
        "HumanApprovalDenied",
        "NovaSealApplied",
        "StateTransition",
        "MemoryOperation",
        "GuardrailEvaluated",
        "EvaluatorScored",
        "RerankerApplied",
        "VectorRetrievalStarted",
        "VectorRetrievalCompleted",
        "VectorRetrievalFailed",
        "EndpointRouted"
      ]
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant identifier for multi-tenant deployments"
    },
    "capsule_id": {
      "type": "string",
      "description": "Identifier of the capsule this event belongs to"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the event"
    },
    "schema_version": {
      "type": "string",
      "description": "Schema version (semver)",
      "default": "1.0.0"
    },
    "allowed_processing_regions": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Data sovereignty: list of allowed processing regions (empty = no restriction)",
      "default": []
    },
    "cost_facet": {
      "$ref": "#/$defs/CostFacet"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "CostFacet": {
      "type": "object",
      "description": "Per-model-call cost attribution (cap-002)",
      "required": ["model_id", "provider", "input_tokens", "completion_tokens", "cost_usd_estimated"],
      "properties": {
        "model_id": {"type": "string"},
        "provider": {"type": "string"},
        "input_tokens": {"type": "integer", "minimum": 0},
        "completion_tokens": {"type": "integer", "minimum": 0},
        "cached_tokens": {"type": "integer", "minimum": 0, "default": 0},
        "cost_usd_estimated": {"type": "number", "minimum": 0},
        "energy_joules_estimated": {"type": ["number", "null"], "minimum": 0}
      }
    }
  }
}
