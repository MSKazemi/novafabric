{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novafabric.io/schemas/masker-finding.schema.json",
  "$comment": "schema_version 0.1.0; tracks the private design/spec/pii-masking-pipeline-v0.md (ADR-0135, accepted 2026-07-13; implementation experimental). Additive, opt-in, offline, Tier-A plugin point layered AFTER the built-in ADR-0009 scanners; extends redaction-proof.json. Absent config => ADR-0009 behavior unchanged. Maskers are pure/deterministic/offline; raw value never stored.",
  "title": "MaskerFinding",
  "description": "One redaction-proof.json masker_findings[] entry — one custom mask applied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "masker_id",
    "masker_version",
    "pattern_id",
    "target_kind",
    "target_ref",
    "byte_offset",
    "byte_length",
    "match_hash",
    "redaction_strategy",
    "replacement",
    "chain_position"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "masker_id": {
      "type": "string",
      "minLength": 1
    },
    "masker_version": {
      "type": "string"
    },
    "pattern_id": {
      "type": "string"
    },
    "target_kind": {
      "type": "string"
    },
    "target_ref": {
      "type": "string"
    },
    "byte_offset": {
      "type": "integer",
      "minimum": 0
    },
    "byte_length": {
      "type": "integer",
      "minimum": 0
    },
    "match_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "redaction_strategy": {
      "enum": [
        "mask",
        "hash",
        "drop"
      ]
    },
    "replacement": {
      "type": "string"
    },
    "chain_position": {
      "type": "integer",
      "minimum": 0
    }
  }
}
