{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novafabric.io/schemas/diff-report-v1.schema.json",
  "$comment": "schema_version 1.0.0; validates the JSON produced by nova diff --output-format json.  STATUS: OAS v1.0 TARGET schema, NOT yet in force (ADR-0034 \u00a71 conditions 2 and 3 are open as of 2026-08-02). The in-force copy is under src/novafabric/schemas/ and keeps the original $id. See ADR-0223.",
  "title": "DiffReport",
  "description": "Structural diff report between two NovaFabric run capsules.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "run_a_id",
    "run_b_id",
    "summary",
    "sections"
  ],
  "properties": {
    "run_a_id": {
      "type": "string",
      "description": "run_id (or path) of the first capsule."
    },
    "run_b_id": {
      "type": "string",
      "description": "run_id (or path) of the second capsule."
    },
    "summary": {
      "type": "object",
      "required": [
        "changed",
        "added",
        "removed"
      ],
      "properties": {
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "Aggregate change counts across all sections."
    },
    "has_changes": {
      "type": "boolean",
      "description": "True on any changed, added or removed entry: the property nova diff --assert-no-regressions gates on (ADR-0303). Optional."
    },
    "skipped_malformed_lines": {
      "type": "object",
      "description": "Non-blank record lines that were not UTF-8, not JSON, or not a JSON object, per side (a, b) and record file. They took no part in the comparison: any non-zero count makes it incomplete, and nova diff --assert-no-regressions then exits 2 (ADR-0303 Amendment 1). Optional; when emitted, zeros are included.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "integer",
          "minimum": 0
        },
        "properties": {
          "model_calls": {
            "type": "integer",
            "minimum": 0,
            "description": "Lines of model-calls.jsonl skipped."
          },
          "tool_calls": {
            "type": "integer",
            "minimum": 0,
            "description": "Lines of tool-calls.jsonl skipped."
          }
        }
      },
      "properties": {
        "a": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "properties": {
            "model_calls": {
              "type": "integer",
              "minimum": 0,
              "description": "Lines of model-calls.jsonl skipped."
            },
            "tool_calls": {
              "type": "integer",
              "minimum": 0,
              "description": "Lines of tool-calls.jsonl skipped."
            }
          }
        },
        "b": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "properties": {
            "model_calls": {
              "type": "integer",
              "minimum": 0,
              "description": "Lines of model-calls.jsonl skipped."
            },
            "tool_calls": {
              "type": "integer",
              "minimum": 0,
              "description": "Lines of tool-calls.jsonl skipped."
            }
          }
        }
      }
    },
    "sections": {
      "type": "object",
      "required": [
        "environment",
        "model_calls",
        "tool_calls",
        "outputs"
      ],
      "properties": {
        "environment": {
          "type": "object",
          "properties": {
            "changes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string"
                  },
                  "before": {},
                  "after": {},
                  "severity": {
                    "type": "string",
                    "enum": [
                      "minor",
                      "major"
                    ]
                  }
                }
              }
            }
          }
        },
        "model_calls": {
          "type": "object",
          "properties": {
            "aligned": {
              "type": "integer",
              "minimum": 0
            },
            "changed": {
              "type": "integer",
              "minimum": 0
            },
            "added": {
              "type": "integer",
              "minimum": 0
            },
            "removed": {
              "type": "integer",
              "minimum": 0
            },
            "pairs": {
              "type": "array"
            }
          }
        },
        "tool_calls": {
          "type": "object",
          "properties": {
            "aligned": {
              "type": "integer",
              "minimum": 0
            },
            "pairs": {
              "type": "array"
            }
          }
        },
        "outputs": {
          "type": "object",
          "properties": {
            "changes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "before_hash": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "after_hash": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
