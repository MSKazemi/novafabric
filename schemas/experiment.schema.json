{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novafabric.io/schemas/experiment.schema.json",
  "$comment": "Accepted (ADR-0120, 2026-07-13); implemented experimental 2026-07-15. Graduated from design/spec/schemas/ \u2014 identity metadata changed only, contract unchanged. schema_version 0.1.0. Tracks design/spec/dataset-experiment-v0.md. New optional artifact \u2014 does not alter Run Capsule, Score, or eval_results schemas.",
  "title": "Experiment",
  "description": "Immutable, content-addressed dataset-experiment record (one target across a pinned dataset).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "dataset_ref",
    "target",
    "runs",
    "aggregate",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "dataset_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "dataset_hash",
        "split_hash"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "dataset_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "split_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "asset",
            "prompt",
            "agent"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "capsule_ref",
          "score_ids"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "capsule_ref": {
            "type": "string",
            "minLength": 1
          },
          "score_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
            }
          },
          "status": {
            "enum": [
              "ok",
              "error",
              "skipped"
            ]
          }
        }
      }
    },
    "aggregate": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "value_type",
          "reducer",
          "value",
          "n"
        ],
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "value_type": {
            "enum": [
              "boolean",
              "numeric"
            ]
          },
          "reducer": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "n": {
            "type": "integer",
            "minimum": 0
          },
          "wilson": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            ]
          }
        }
      }
    },
    "status": {
      "enum": [
        "running",
        "finalized"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "score_config_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "finalized_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "content_hash": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "baseline_experiment_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        }
      ]
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
