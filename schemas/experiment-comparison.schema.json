{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novafabric.io/schemas/experiment-comparison.schema.json",
  "$comment": "Accepted (ADR-0120, 2026-07-13); implemented experimental 2026-07-15. Graduated from the private design/spec/schemas/ \u2014 identity metadata changed only, contract unchanged. schema_version 0.1.0. Tracks the private design/spec/dataset-experiment-v0.md. New optional artifact \u2014 does not alter Run Capsule, Score, or eval_results schemas.",
  "title": "ExperimentComparison",
  "description": "Result of `nova experiment compare` \u2014 embeds an ADR-0080 significance verdict verbatim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "comparison_of",
    "dataset_ref",
    "metric",
    "per_item",
    "significance",
    "exit_code",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "comparison_of": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_experiment_id",
        "candidate_experiment_id"
      ],
      "properties": {
        "baseline_experiment_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "candidate_experiment_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        }
      }
    },
    "dataset_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "dataset_hash",
        "split_hash"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "dataset_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "split_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "metric": {
      "type": "string",
      "minLength": 1
    },
    "per_item": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "changed"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "baseline": {
            "type": [
              "number",
              "null"
            ]
          },
          "candidate": {
            "type": [
              "number",
              "null"
            ]
          },
          "changed": {
            "type": "boolean"
          }
        }
      }
    },
    "significance": {
      "type": "object"
    },
    "exit_code": {
      "type": "integer",
      "enum": [
        0,
        3
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "score_config": {
      "description": "ADR-0117 P4 comparability report keyed by ScoreConfig digest. comparable: true = same digest; false = different digests (explicitly not comparable); null = at least one side not pinned (never assumed). Optional; absent on records written before P4.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparable",
        "status",
        "message"
      ],
      "properties": {
        "comparable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "status": {
          "enum": [
            "same_digest",
            "different_digest",
            "not_pinned"
          ]
        },
        "baseline_digest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          ]
        },
        "candidate_digest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          ]
        },
        "baseline_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidate_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "same_digest"
              }
            }
          },
          "then": {
            "properties": {
              "comparable": {
                "const": true
              }
            },
            "required": [
              "baseline_digest",
              "candidate_digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "different_digest"
              }
            }
          },
          "then": {
            "properties": {
              "comparable": {
                "const": false
              }
            },
            "required": [
              "baseline_digest",
              "candidate_digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_pinned"
              }
            }
          },
          "then": {
            "properties": {
              "comparable": {
                "const": null
              }
            }
          }
        }
      ]
    }
  }
}
