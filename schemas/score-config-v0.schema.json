{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novafabric.io/schemas/score-config-v0.schema.json",
  "$comment": "schema_version 0.1.0; tracks design/spec/score-config-v0.md and ADR-0117 (accepted 2026-07-13). A ScoreConfig is a named, immutable, content-addressed catalog entry constraining Scores under the same name; it extends the existing Score model (ADR-0099) additively and does not change scores.jsonl or score-v1.schema.json. Experimental \u2014 not yet a frozen format.",
  "title": "ScoreConfig",
  "description": "Named, immutable, content-addressed definition constraining a Score's shape for cross-capsule comparability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_id",
    "name",
    "value_type",
    "description",
    "version",
    "content_digest",
    "created_at"
  ],
  "properties": {
    "config_id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "value_type": {
      "enum": [
        "boolean",
        "categorical",
        "numeric"
      ]
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "string"
          },
          "ordinal": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "direction": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "higher-better",
            "lower-better",
            null
          ]
        }
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "value_type": {
            "const": "boolean"
          }
        }
      },
      "then": {
        "properties": {
          "categories": false,
          "range": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "value_type": {
            "const": "categorical"
          }
        }
      },
      "then": {
        "required": [
          "categories"
        ],
        "properties": {
          "range": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "value_type": {
            "const": "numeric"
          }
        }
      },
      "then": {
        "required": [
          "range"
        ],
        "properties": {
          "categories": false
        }
      }
    }
  ]
}
