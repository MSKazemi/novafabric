---
import Layout from '../../components/layout/Layout.astro';
import ShowcaseBadge from '../../components/layout/ShowcaseBadge.astro';
import LineageGraph from '../../components/lineage/LineageGraph';
import CodeBlock from '../../components/ui/CodeBlock.astro';
---

<Layout
  title="Lineage graph — NovaFabric Showcase"
  description="An interactive lineage DAG over the code-review-agent fixture. Provenance, blast radius, and replay chain — three queries in three clicks."
>
  <article class="container-content py-12">
    <header class="mb-8 max-w-3xl">
      <ShowcaseBadge variant="page" />
      <p class="mt-4 text-xs uppercase tracking-wider text-[var(--color-text-faint)]">Primitive 04 — interactive demo</p>
      <h1 class="mt-1 text-4xl font-medium tracking-tight text-balance">Lineage graph</h1>
      <p class="mt-3 text-[var(--color-text-muted)] max-w-2xl">
        Every run, asset, and artifact is a node. Every <em>consumed</em>,
        <em>produced</em>, <em>replayed_from</em>, or <em>evaluated_by</em>
        relationship is an edge. Three toolbar modes mirror the CLI:
        <code class="text-[var(--color-text)] text-sm">nova lineage provenance</code>,
        <code class="text-[var(--color-text)] text-sm">blast-radius</code>,
        <code class="text-[var(--color-text)] text-sm">replay-chain</code>.
      </p>
    </header>

    <LineageGraph client:only="react" />

    <aside class="mt-6 max-w-3xl rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-raised)] p-5 text-sm text-[var(--color-text-muted)] leading-relaxed">
      <p class="text-[var(--color-text)] font-medium mb-2">The wow moment</p>
      <p>
        Click <code class="text-[var(--color-text)] font-mono text-xs bg-[var(--color-bg-sunken)] px-1.5 py-0.5 rounded">code-review-prompt</code>
        and switch to <strong>Blast radius</strong>. You can see, in two seconds, every
        production run that depends on that prompt. Change it, and you know
        exactly what will be affected. No greps. No tribal memory.
      </p>
    </aside>

    <section class="mt-12 max-w-3xl">
      <h2 class="text-xl font-medium text-[var(--color-text)] tracking-tight mb-4">On your machine</h2>
      <p class="text-[var(--color-text-muted)] mb-4">
        The same queries are available on the CLI. Output is JSON or text;
        no graph required.
      </p>
      <CodeBlock code="nova lineage provenance run:01KR5SQZPDGTKE3MDP3ZRX8WP1
nova lineage blast-radius asset:code-review-prompt@0.1.0
nova lineage replay-chain run:01KR5SQZPDGTKE3MDP3ZRX8WP1" lang="bash" />
    </section>
  </article>
</Layout>
