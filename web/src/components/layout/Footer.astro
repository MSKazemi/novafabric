---
import { GITHUB_REPO } from '../../lib/links';

const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-border)] mt-24 bg-[var(--color-bg-sunken)]">
  <div class="container-content py-12">
    <div class="grid gap-12 md:grid-cols-5">
      <div class="md:col-span-2">
        <p class="text-sm text-[var(--color-text-muted)] max-w-md leading-relaxed">
          The CLI is the canonical interface. This site is documentation —
          a showcase that explains what NovaFabric does, using a single
          baked-in example. It does not read your data and does not phone
          home.
        </p>
        <p class="mt-4 text-xs text-[var(--color-text-faint)]">
          <code class="bg-[var(--color-bg-raised)] px-2 py-1 rounded text-[var(--color-text-muted)]">pip install novafabric</code>
          <span class="mx-2">→</span>
          <code class="bg-[var(--color-bg-raised)] px-2 py-1 rounded text-[var(--color-text-muted)]">nova capture python your_agent.py</code>
        </p>
      </div>

      <div>
        <h4 class="text-xs uppercase tracking-wider text-[var(--color-text-faint)] mb-3">Showcase</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/showcase/capsule" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]">Run Capsule</a></li>
          <li><a href="/showcase/replay" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]">Replay</a></li>
          <li><a href="/showcase/lineage" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]">Lineage</a></li>
          <li><a href="/showcase/registry" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]">Registry</a></li>
          <li><a href="/showcase/evidence" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]">Evidence</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-xs uppercase tracking-wider text-[var(--color-text-faint)] mb-3">Project</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/concepts" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]">Concepts</a></li>
          <li><a href="/why" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]">Why now</a></li>
          <li><a href="/install" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]">Install</a></li>
          <li><a href="/spec" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]">Spec</a></li>
          <li><a href={GITHUB_REPO} rel="noopener" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]">GitHub</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-xs uppercase tracking-wider text-[var(--color-text-faint)] mb-3">Site</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/novafabric/" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]">Product</a></li>
          <li><a href="/docs/" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]">Documentation</a></li>
          <li><a href="/docs/getting-started/" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]">Getting started</a></li>
          <li><a href="/docs/comparison/" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]">Compare</a></li>
          <li><a href="/demo/" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]">Demo</a></li>
          <li><a href="/blog/" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]">Blog</a></li>
          <li><a href="/research/" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]">Research</a></li>
          <li><a href="/primitives/" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]">Primitives</a></li>
          <li><a href="/architecture/" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]">Architecture</a></li>
          <li><a href="/changelog/" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]">Changelog</a></li>
          <li><a href="/capsules/" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)]">Capsules</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-[var(--color-border)] flex flex-wrap items-center justify-between gap-3 text-xs text-[var(--color-text-faint)]">
      <span>© {year} NovaFabric — Apache-2.0</span>
      <span>This is a showcase site, not a viewer. The CLI is the canonical interface.</span>
    </div>
  </div>
</footer>
