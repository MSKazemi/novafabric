{
  "name": "novafabric-showcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Showcase site explaining NovaFabric's five primitives. Documentation, not a viewer.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build:dashboard": "astro build && node scripts/copy-dashboard.mjs",
    "lint": "tsc --noEmit",
    "check:licenses": "node scripts/check-licenses.mjs",
    "build:fixtures": "python3 scripts/build_showcase_fixture.py && node scripts/sign-evidence.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test tests/e2e",
    "test:visual": "playwright test tests/visual",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "lhci": "lhci autorun --config=.lighthouserc.json"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@noble/ed25519": "^3.1.0",
    "@tanstack/react-virtual": "^3.14.10",
    "@xyflow/react": "^12.11.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "^7.2.7",
    "clsx": "^2.1.1",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "js-yaml": "^5.4.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tmp": "^0.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "ws": ">=8.20.1",
    "qs": ">=6.15.2",
    "uuid": ">=11.1.1",
    "esbuild": ">=0.28.1",
    "brace-expansion": ">=5.0.8"
  }
}
