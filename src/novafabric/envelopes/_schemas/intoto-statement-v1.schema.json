{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novafabric.dev/schemas/envelopes/intoto-statement-v1.schema.json",
  "title": "in-toto Statement v1",
  "description": "Structural schema for the in-toto Attestation Framework Statement layer (https://in-toto.io/Statement/v1). Vendored by NovaFabric to validate emitter output against the standard's required-field contract.",
  "type": "object",
  "required": ["_type", "subject", "predicateType"],
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["digest"],
        "properties": {
          "name": {"type": "string"},
          "digest": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "string"}
          }
        }
      }
    },
    "predicateType": {
      "type": "string",
      "format": "uri"
    },
    "predicate": {"type": "object"}
  }
}
