{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novafabric.io/schemas/secret-redaction.schema.json",
  "$comment": "schema_version 0.1.0; tracks design/spec/secret-policy-v0.md. Validates redaction-proof.json inside a Run Capsule.",
  "title": "RedactionProof",
  "description": "redaction-proof.json inside a NovaFabric Run Capsule. Records what secret scanning detected, where, and how secrets were redacted — without storing the secrets themselves.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proof_id",
    "capsule_run_id",
    "created_at",
    "scanner",
    "packs",
    "targets",
    "findings_count",
    "findings",
    "bytes_scanned",
    "bytes_redacted",
    "chain_hash"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+",
      "description": "Schema version. v0.4 ships 0.1.0."
    },
    "proof_id": {
      "$ref": "#/$defs/Ulid",
      "description": "Unique proof identifier."
    },
    "capsule_run_id": {
      "$ref": "#/$defs/Ulid",
      "description": "Must match the capsule's run_id. Validated at replay time."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the secret scan completed (RFC 3339)."
    },
    "scanner": {
      "$ref": "#/$defs/ScannerIdentity",
      "description": "Identity of the scanner that produced this proof."
    },
    "packs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PackRef"
      },
      "description": "Rule packs applied during this scan."
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ScanTarget"
      },
      "description": "Per-target scan records. One entry per scanned source."
    },
    "findings_count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "by_severity"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "by_severity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ],
          "properties": {
            "critical": {
              "type": "integer",
              "minimum": 0
            },
            "high": {
              "type": "integer",
              "minimum": 0
            },
            "medium": {
              "type": "integer",
              "minimum": 0
            },
            "low": {
              "type": "integer",
              "minimum": 0
            },
            "info": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "description": "Summary counts of all findings."
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "description": "One entry per detection. Matched bytes are never stored here."
    },
    "redaction_strategy_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "strategy"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "strategy": {
            "type": "string",
            "enum": [
              "mask",
              "hash",
              "drop"
            ]
          },
          "rationale": {
            "type": "string"
          }
        }
      },
      "description": "Per-rule strategy overrides applied. Empty array when defaults were used."
    },
    "unsafe_skips": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/UnsafeSkip"
      },
      "description": "User-applied decisions to keep a matched value. Any entry blocks export-evidence unless --allow-unsafe-skips is passed."
    },
    "bytes_scanned": {
      "type": "integer",
      "minimum": 0,
      "description": "Total bytes covered by the scan."
    },
    "bytes_redacted": {
      "type": "integer",
      "minimum": 0,
      "description": "Total bytes replaced or removed."
    },
    "chain_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 over the proof's canonical JSON serialization. Computed last; verified at replay and export."
    },
    "signature": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "signer_identity",
            "signed_at"
          ],
          "properties": {
            "signer_identity": {
              "type": "string"
            },
            "signed_at": {
              "type": "string",
              "format": "date-time"
            },
            "signature_algorithm": {
              "type": "string"
            },
            "rekor_log_index": {
              "type": "integer"
            },
            "bundle_path": {
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional Sigstore signature over chain_hash. Populated by export-evidence."
    },
    "masker_findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MaskerFinding"
      },
      "description": "ADR-0135 (optional, additive): one entry per mask applied by an operator-registered masker, after the built-in scanners. Matched bytes are never stored; match_hash attributes them."
    },
    "masker_errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MaskerError"
      },
      "description": "ADR-0135 (optional, additive): one entry per masker failure/abort. The field was fail-closed (redacted/dropped); capture continued."
    }
  },
  "$defs": {
    "Ulid": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "26-character Crockford base32 ULID."
    },
    "ContentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 content hash in sha256:<hex> form."
    },
    "ScannerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "engine",
        "engine_version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Scanner component name, e.g. 'novafabric.secrets'."
        },
        "version": {
          "type": "string",
          "description": "Scanner version."
        },
        "engine": {
          "type": "string",
          "description": "Detection engine kind, e.g. 'regex+entropy'."
        },
        "engine_version": {
          "type": "string",
          "description": "Detection engine version."
        }
      }
    },
    "PackRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "rules_count",
        "rules_hash"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Pack name, e.g. 'gitleaks-extended-v0'."
        },
        "version": {
          "type": "string",
          "description": "Pack version."
        },
        "rules_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of rules in the pack."
        },
        "rules_hash": {
          "$ref": "#/$defs/ContentHash",
          "description": "SHA-256 of the pack's rules.yaml. Enables third-party rule verification."
        }
      }
    },
    "ScanTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "bytes_scanned",
        "findings_count",
        "skipped",
        "binary",
        "hash_before_redaction",
        "hash_after_redaction"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "capsule-yaml",
            "trace",
            "model-call-messages",
            "tool-call-arguments",
            "tool-call-result",
            "mcp-envelope",
            "input-artifact",
            "output-artifact",
            "env-lock",
            "assets",
            "lineage",
            "file-events",
            "network-events",
            "human-approvals",
            "state-transitions",
            "memory-operations",
            "guardrail-events",
            "evaluator-events",
            "reranker-events",
            "vector-retrievals"
          ],
          "description": "Type of capsule surface that was scanned."
        },
        "ref": {
          "type": "string",
          "description": "Specific reference within the capsule, e.g. 'tool-calls.jsonl#L17'."
        },
        "bytes_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "findings_count": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "boolean",
          "description": "True if this target was excluded from scanning."
        },
        "skip_reason": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Reason the target was skipped, if applicable."
        },
        "binary": {
          "type": "boolean",
          "description": "True if this target was a binary artifact."
        },
        "hash_before_redaction": {
          "$ref": "#/$defs/ContentHash",
          "description": "SHA-256 of the target bytes before redaction."
        },
        "hash_after_redaction": {
          "$ref": "#/$defs/ContentHash",
          "description": "SHA-256 of the target bytes after redaction. Equals hash_before_redaction when findings_count is 0."
        }
      }
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "rule_id",
        "rule_version",
        "pack",
        "severity",
        "target_kind",
        "target_ref",
        "byte_offset",
        "byte_length",
        "match_hash",
        "redaction_strategy",
        "replacement"
      ],
      "properties": {
        "finding_id": {
          "$ref": "#/$defs/Ulid",
          "description": "Unique finding identifier within this proof."
        },
        "rule_id": {
          "type": "string",
          "description": "Rule that triggered this finding, e.g. 'openai-api-key'."
        },
        "rule_version": {
          "type": "string",
          "description": "Version of the rule."
        },
        "pack": {
          "type": "string",
          "description": "Pack that contains this rule."
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ],
          "description": "Severity inherited from the rule."
        },
        "target_kind": {
          "type": "string",
          "description": "The ScanTarget kind where this finding was detected."
        },
        "target_ref": {
          "type": "string",
          "description": "Specific location in the target, e.g. 'model-calls.jsonl#L4 messages[2].content'."
        },
        "byte_offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Byte offset of the matched region within the target."
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "description": "Length in bytes of the matched region."
        },
        "match_hash": {
          "$ref": "#/$defs/ContentHash",
          "description": "SHA-256 of the matched bytes. Enables hash-equality verification without storing the secret."
        },
        "redaction_strategy": {
          "type": "string",
          "enum": [
            "mask",
            "hash",
            "drop"
          ],
          "description": "Strategy applied to this finding."
        },
        "replacement": {
          "type": "string",
          "description": "The replacement text used, e.g. '[REDACTED:openai-api-key]'. Empty for 'drop' strategy."
        },
        "context_before_hash": {
          "$ref": "#/$defs/ContentHash",
          "description": "SHA-256 of 16 bytes immediately before the match. Helps distinguish co-located findings."
        },
        "context_after_hash": {
          "$ref": "#/$defs/ContentHash",
          "description": "SHA-256 of 16 bytes immediately after the match."
        }
      }
    },
    "UnsafeSkip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "rule_id",
        "rationale",
        "decided_by",
        "decided_at"
      ],
      "properties": {
        "finding_id": {
          "$ref": "#/$defs/Ulid",
          "description": "The finding the user decided to keep."
        },
        "rule_id": {
          "type": "string",
          "description": "Rule that generated the finding."
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "description": "Why the user chose to keep this matched value. Required."
        },
        "decided_by": {
          "type": "string",
          "description": "Identity that made the decision, e.g. 'user@example.com' or 'interactive-cli'."
        },
        "decided_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the decision was made (RFC 3339)."
        }
      }
    },
    "MaskerFinding": {
      "title": "MaskerFinding",
      "description": "One redaction-proof.json masker_findings[] entry — one custom mask applied.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "masker_id",
        "masker_version",
        "pattern_id",
        "target_kind",
        "target_ref",
        "byte_offset",
        "byte_length",
        "match_hash",
        "redaction_strategy",
        "replacement",
        "chain_position"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "masker_id": {
          "type": "string",
          "minLength": 1
        },
        "masker_version": {
          "type": "string"
        },
        "pattern_id": {
          "type": "string"
        },
        "target_kind": {
          "type": "string"
        },
        "target_ref": {
          "type": "string"
        },
        "byte_offset": {
          "type": "integer",
          "minimum": 0
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "match_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "redaction_strategy": {
          "enum": [
            "mask",
            "hash",
            "drop"
          ]
        },
        "replacement": {
          "type": "string"
        },
        "chain_position": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "MaskerError": {
      "title": "MaskerError",
      "description": "One redaction-proof.json masker_errors[] entry — a fail-closed masker failure/abort.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "masker_id",
        "masker_version",
        "target_ref",
        "reason",
        "action_taken"
      ],
      "properties": {
        "masker_id": {
          "type": "string",
          "minLength": 1
        },
        "masker_version": {
          "type": "string"
        },
        "target_ref": {
          "type": "string"
        },
        "reason": {
          "enum": [
            "raised",
            "timeout",
            "oversize",
            "declined_invalid"
          ]
        },
        "action_taken": {
          "enum": [
            "redact",
            "drop"
          ]
        },
        "detail_hash": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          ]
        }
      }
    }
  }
}
